# Valori dimostrativi: sostituire la password prima del primo avvio.
POSTGRES_DB=storycast_db
POSTGRES_USER=storycast
POSTGRES_PASSWORD=CHANGE_ME_GENERATE_A_RANDOM_PASSWORD
# Directory host con input/ e output/, leggibile dall'UID 10001.
STORYCAST_ROOT=./local/storycast
# Accesso locale predefinito. Per la LAN impostare IP e subnet reali.
WEB_BIND_IP=127.0.0.1
WEB_ALLOWED_NETWORKS=127.0.0.0/8,::1/128
# Impostare 1 solo dopo il download completo del modello.
HF_HUB_OFFLINE=0
